# ─── JurisClass AI — Variáveis de Ambiente ────────────────────────────────────
# Copie este arquivo para .env e preencha os valores desejados.
#
#   cp .env.example .env

# Token do Hugging Face (necessário se o repositório do modelo for privado)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Repositório e revisão do modelo no Hugging Face Hub
# Se a variável estiver ausente ou vazia, o Compose usa o repositório público padrão.
# HF_MODEL_REPO=gcouzzi/jurisclass-legalbertpt
# HF_MODEL_REVISION=f1b1130e7d7dd59c286c4928a5ca90b893528ed4

# Modo de inferência. O ensemble carrega os cinco folds; false carrega um só.
# USE_ENSEMBLE=true
# FALLBACK_FOLD=5

# Limiar de confiança para abstenção (0.0 a 1.0)
# Deixe vazio para classificação sem limiar (sem abstenção)
# CONFIDENCE_THRESHOLD=0.6
